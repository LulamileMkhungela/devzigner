{
  "name": "prodops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "standalone": "tsx --tsconfig tsconfig.scripts.json scripts/standalone.ts",
    "snapshot": "tsx --tsconfig tsconfig.scripts.json scripts/snapshot.tsx",
    "preview": "vite preview --host 0.0.0.0",
    "preview:static": "tsx --tsconfig tsconfig.scripts.json scripts/preview-server.ts",
    "preview:site": "tsx --tsconfig tsconfig.scripts.json scripts/site-server.ts",
    "qa": "tsx scripts/qa.ts",
    "render-check": "tsx --tsconfig tsconfig.scripts.json scripts/render-check.tsx",
    "check": "npm run render-check && npm run site-check && npm run test && npm run export-check && npm run walkthrough && npm run example-app && npm run smoke && npm run browser-check && npm run qa && npm run build",
    "smoke": "tsx --tsconfig tsconfig.scripts.json scripts/smoke.tsx",
    "browser-check": "tsx --tsconfig tsconfig.scripts.json scripts/browser-check.ts",
    "export-check": "tsx --tsconfig tsconfig.scripts.json scripts/export-check.ts",
    "walkthrough": "tsx --tsconfig tsconfig.scripts.json scripts/walkthrough.tsx",
    "example-app": "tsx --tsconfig tsconfig.scripts.json scripts/example-app.ts",
    "test": "node --import tsx --test scripts/unit.test.ts",
    "site-check": "tsx --tsconfig tsconfig.scripts.json scripts/site-check.ts",
    "kit": "tsx --tsconfig tsconfig.scripts.json scripts/emit-kit.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@angular/compiler": "^19.2.25",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vue/compiler-sfc": "^3.5.44",
    "jsdom": "^30.1.3",
    "lit": "^3.3.3",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue": "^3.5.44"
  },
  "license": "MIT",
  "description": "ProdOps \u2014 a product-planning and UI-design framework by Lulamile Mkhungela. Five stages from an idea to a handoff: product, data shape, design system, sections, export.",
  "author": "Lulamile Mkhungela",
  "keywords": [
    "design-system",
    "dtcg",
    "product-planning",
    "prototype",
    "handoff"
  ]
}
