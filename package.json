{
  "name": "lula-devzign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "standalone": "tsx --tsconfig tsconfig.scripts.json scripts/standalone.ts",
    "preview": "vite preview --host 0.0.0.0",
    "preview:static": "tsx --tsconfig tsconfig.scripts.json scripts/preview-server.ts",
    "qa": "tsx scripts/qa.ts",
    "render-check": "tsx --tsconfig tsconfig.scripts.json scripts/render-check.tsx",
    "check": "npm run render-check && npm run test && npm run export-check && npm run walkthrough && npm run example-app && npm run smoke && npm run browser-check && npm run qa && npm run build",
    "smoke": "tsx --tsconfig tsconfig.scripts.json scripts/smoke.tsx",
    "browser-check": "tsx --tsconfig tsconfig.scripts.json scripts/browser-check.ts",
    "export-check": "tsx --tsconfig tsconfig.scripts.json scripts/export-check.ts",
    "walkthrough": "tsx --tsconfig tsconfig.scripts.json scripts/walkthrough.tsx",
    "example-app": "tsx --tsconfig tsconfig.scripts.json scripts/example-app.ts",
    "test": "node --import tsx --test scripts/unit.test.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vue/compiler-sfc": "^3.5.44",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue": "^3.5.44"
  },
  "license": "MIT",
  "description": "Lula DevZign \u2014 a deterministic design compiler. One seed to a full product package: brief, data model, design system, screens, tests and agent handoff."
}
