{
  "name": "lula-devzign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "qa": "tsx scripts/qa.ts",
    "render-check": "tsx --tsconfig tsconfig.scripts.json scripts/render-check.tsx",
    "check": "npm run render-check && npm run qa && npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "license": "MIT",
  "description": "Lula DevZign \u2014 a deterministic design compiler. One seed to a full product package: brief, data model, design system, screens, tests and agent handoff."
}
